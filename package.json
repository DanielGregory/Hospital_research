{
  "name": "er-optimization-game",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/sim && tsc -p tools/headless && tsc -p apps/game",
    "headless": "tsx tools/headless/src/cli.ts",
    "e2e": "pnpm --filter @er/game build && tsx apps/game/e2e/smoke.ts",
    "game": "pnpm --filter @er/game dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "playwright-core": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
